; ..\BSW\Nm\Nm.c	  5935    \ACCEPT TX
; ..\BSW\Nm\Nm.c	  5936    \REASON The condition checks for generation failures that cannot be simulated.
; ..\BSW\Nm\Nm.c	  5937            (Existence of a pointer to an upper layer function)
; ..\BSW\Nm\Nm.c	  5938  
; ..\BSW\Nm\Nm.c	  5939  \ID COV_NM_CONFIG_FUNC_CALL
; ..\BSW\Nm\Nm.c	  5940    \ACCEPT XF
; ..\BSW\Nm\Nm.c	  5941    \ACCEPT TX
; ..\BSW\Nm\Nm.c	  5942    \REASON The callback function has not been configured for certain configurations,
; ..\BSW\Nm\Nm.c	  5943            thus condition always true for an specific configuration.
; ..\BSW\Nm\Nm.c	  5944  
; ..\BSW\Nm\Nm.c	  5945  \ID COV_NM_CONFIG_FRNM
; ..\BSW\Nm\Nm.c	  5946    \ACCEPT TF tx tf
; ..\BSW\Nm\Nm.c	  5947    \REASON There might be configurations where FrNm is the only BusNm configured and thus the comparison is always
; ..\BSW\Nm\Nm.c	  5948            true.
; ..\BSW\Nm\Nm.c	  5949  
; ..\BSW\Nm\Nm.c	  5950  \ID COV_NM_CONFIG_SYNCHRONIZATION_TIMEOUT
; ..\BSW\Nm\Nm.c	  5951    \ACCEPT TX
; ..\BSW\Nm\Nm.c	  5952    \REASON There might be configurations where NM_SYNCHRONIZATION_TIMEOUT_TIME is defined to 1 and therefore the for
