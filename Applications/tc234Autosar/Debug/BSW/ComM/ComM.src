; ..\BSW\ComM\ComM.c	  6560                     'Versioninfo': ComM_GetVersionInfo().
; ..\BSW\ComM\ComM.c	  6561  
; ..\BSW\ComM\ComM.c	  6562  \ID                SBSW_COMM_CALL_WITH_PTR_TO_CONST
; ..\BSW\ComM\ComM.c	  6563  \DESCRIPTION       A pointer to constant data is passed to a called function.
; ..\BSW\ComM\ComM.c	  6564  \COUNTERMEASURE \N The pointed data is constant and cannot be written.
; ..\BSW\ComM\ComM.c	  6565  
; ..\BSW\ComM\ComM.c	  6566  \ID                SBSW_COMM_CALL_BUSSM_GET_CURRENT_COMMODE
; ..\BSW\ComM\ComM.c	  6567  \DESCRIPTION       A pointer is passed to a BusSM function as parameter and could be used within the function directly to write to a memory location.
; ..\BSW\ComM\ComM.c	  6568  \COUNTERMEASURE \N This function is called by ComM_GetCurrentComMode() only, which provides a pointer to a local variable.
; ..\BSW\ComM\ComM.c	  6569                     This pointer is passed to the callee (BusSM) without changes. This ensures that the callee always gets a valid pointer.
; ..\BSW\ComM\ComM.c	  6570  
; ..\BSW\ComM\ComM.c	  6571  \ID                SBSW_COMM_PASSED_PTR_WRITE_ACCESS
; ..\BSW\ComM\ComM.c	  6572  \DESCRIPTION       A pointer is passed to ComM_GetCurrentBusSMMode() and is used within the function directly to write to a memory location.
; ..\BSW\ComM\ComM.c	  6573  \COUNTERMEASURE \N This function is called by ComM_GetCurrentComMode() only, which provides a pointer to a local variable.
; ..\BSW\ComM\ComM.c	  6574  
; ..\BSW\ComM\ComM.c	  6575  \ID                SBSW_COMM_CALL_WITH_PTR_TO_LOCAL_VARIABLE
; ..\BSW\ComM\ComM.c	  6576  \DESCRIPTION       A pointer is passed to a function as parameter and is used within the function directly to write to a memory location.
; ..\BSW\ComM\ComM.c	  6577  \COUNTERMEASURE \N The passed pointer references a local stack variable and is therefore always valid.
; ..\BSW\ComM\ComM.c	  6578  
; ..\BSW\ComM\ComM.c	  6579  \ID                SBSW_COMM_ARRAY_CHANNEL_REQUESTORS_WRITE
; ..\BSW\ComM\ComM.c	  6580  \DESCRIPTION       The function writes to the array handleArray[]. The index is limited by a generated define containing the array size.
; ..\BSW\ComM\ComM.c	  6581                     The type of the array is defined by RTE because it is used to exchange data via Sender-Receiver Interface ComM_CurrentChannelRequest.
; ..\BSW\ComM\ComM.c	  6582  \COUNTERMEASURE \S Verify that the array size generated by ComM matches to the array size in the type definition of RTE. The following procedure shall be
; ..\BSW\ComM\ComM.c	  6583                     applied to each channel that has activated the ComM parameter 'Full Comm Request Notification Enabled'.
; ..\BSW\ComM\ComM.c	  6584                     1) ComM_Cfg.h contains array size definition in the format COMM_MAX_CR_<ShortNameOfChannel>
; ..\BSW\ComM\ComM.c	  6585                     2) rte_type.h contains the definition of the corresponding structure type in the format ComM_UserHandleArrayType_<ShortNameOfChannel>
; ..\BSW\ComM\ComM.c	  6586                     3) Verify that the structure member 'handleArray' has the same size as the corresponding define value of ComM in 1).
; ..\BSW\ComM\ComM.c	  6587                     4) Verify the content of the generated functions ComM_CurrentChannelRequestInit and ComM_CurrentChannelRequestNotification to ensure that
; ..\BSW\ComM\ComM.c	  6588                        the proper define COMM_MAX_CR_<ShortNameOfChannel> is used to limit the array index when writing to
; ..\BSW\ComM\ComM.c	  6589                        ComM_UserHandleArrayType_<ShortNameOfChannel>.handleArray[]. [SMI-94]
; ..\BSW\ComM\ComM.c	  6590  
; ..\BSW\ComM\ComM.c	  6591  \ID                SBSW_COMM_CALL_COM_RECEIVE_SIGNAL
