; ..\BSW\NvM\NvM.c	  1933  }
; ..\BSW\NvM\NvM.c	  1934  
; ..\BSW\NvM\NvM.c	  1935  #define NVM_STOP_SEC_CODE
; ..\BSW\NvM\NvM.c	  1936  #include "MemMap.h"
; ..\BSW\NvM\NvM.c	  1937  
; ..\BSW\NvM\NvM.c	  1938  /* PRQA L:inclusions */
; ..\BSW\NvM\NvM.c	  1939  
; ..\BSW\NvM\NvM.c	  1940  /* Justification for module specific MISRA deviations: 
; ..\BSW\NvM\NvM.c	  1941  
; ..\BSW\NvM\NvM.c	  1942  MD_NvM_1.2:
; ..\BSW\NvM\NvM.c	  1943  Reason: In case Development Mode is enabled the pointer will be checked not to be NULL. But in Production Mode this check is disabled via preprocessor,
; ..\BSW\NvM\NvM.c	  1944  and a NULL pointer access is possible -> the API caller has to provide a valid version information storage.
; ..\BSW\NvM\NvM.c	  1945  Risk: NULL pointer access
; ..\BSW\NvM\NvM.c	  1946  Prevention: During Development Mode the given pointer will be checked - ensure your application do not call the API with NULL pointer in production mode.
; ..\BSW\NvM\NvM.c	  1947  
; ..\BSW\NvM\NvM.c	  1948  MD_NvM_8.7: 
; ..\BSW\NvM\NvM.c	  1949  Reason: Usage of AUTOSAR's Memory Mapping prohibits nesting of memory sections; thus object cannot be defined locally.
; ..\BSW\NvM\NvM.c	  1950  Risk: The static variable could be modified from any function within its scope.
; ..\BSW\NvM\NvM.c	  1951  Prevention: A code review should ensure the variables are only used by allowed functions.
; ..\BSW\NvM\NvM.c	  1952  
; ..\BSW\NvM\NvM.c	  1953  MD_NvM_8.12:
; ..\BSW\NvM\NvM.c	  1954  Reason: Array of unknown type is used in order to reduce dependencies.
; ..\BSW\NvM\NvM.c	  1955  Risk: In case the array size shall be determined it would be incorrect.
; ..\BSW\NvM\NvM.c	  1956  Prevention: None
; ..\BSW\NvM\NvM.c	  1957  
; ..\BSW\NvM\NvM.c	  1958  MD_NvM_10.1:
; ..\BSW\NvM\NvM.c	  1959  Reason: One reason: QAC Message is caused by bitfields, which are interpreted to be signed int. However, this is wrong; 
; ..\BSW\NvM\NvM.c	  1960  all bitfields are unsigned! QAC itself expects/documents unsigned bitfields to be really unsigned.
; ..\BSW\NvM\NvM.c	  1961  Other reasons: we are using defined values interpreted to be integer but using value fitting into smaller data types. NvM uses the
; ..\BSW\NvM\NvM.c	  1962  fitting data types, defines are just assigned to them.
; ..\BSW\NvM\NvM.c	  1963  Risk: During converting to a smaller data type or another signedness data could get lost
; ..\BSW\NvM\NvM.c	  1964  Prevention: A code review should ensure that the parameters are used correctly
; ..\BSW\NvM\NvM.c	  1965  
; ..\BSW\NvM\NvM.c	  1966  MD_NvM_11.4:
; ..\BSW\NvM\NvM.c	  1967  Reason: Casts are used to reduce the number of bytes to required one, the other bytes/values does not matter.
; ..\BSW\NvM\NvM.c	  1968  Risk: Data loss in case the casted parameter exceeds the cast type.
; ..\BSW\NvM\NvM.c	  1969  Prevention: Code review shall ensure the correct usage of internal variables.
; ..\BSW\NvM\NvM.c	  1970  
; ..\BSW\NvM\NvM.c	  1971  MD_NvM_11.5: 
; ..\BSW\NvM\NvM.c	  1972  Reason: Cast removing const qualifier is necessary.
; ..\BSW\NvM\NvM.c	  1973  Risk: The component is able to modify the pointer content which could result in undefined behavior.
; ..\BSW\NvM\NvM.c	  1974  Prevention: A code review should ensure that the parameters are used correctly.
; ..\BSW\NvM\NvM.c	  1975  
; ..\BSW\NvM\NvM.c	  1976  MD_NvM_12.4:
; ..\BSW\NvM\NvM.c	  1977  Reason: The side effects does not matter here - the first expression has to be combined with one of (or both) the following expressions to be true.
; ..\BSW\NvM\NvM.c	  1978  Risk: A part of an expression may not be evaluated.
; ..\BSW\NvM\NvM.c	  1979  Prevention: Core review should ensure that the expressions does not have any side effects.
; ..\BSW\NvM\NvM.c	  1980  
; ..\BSW\NvM\NvM.c	  1981  MD_NvM_13.2: 
; ..\BSW\NvM\NvM.c	  1982  Reason: Operands is of type (boolean), representing a Boolean value, as defined by AUTOSAR.
; ..\BSW\NvM\NvM.c	  1983  Risk: Type is misused, leading to unexpected behavior.
; ..\BSW\NvM\NvM.c	  1984  Prevention: Review; boolean values shall only be set by (effectively) boolean expressions.
; ..\BSW\NvM\NvM.c	  1985  
; ..\BSW\NvM\NvM.c	  1986  */
; ..\BSW\NvM\NvM.c	  1987  
; ..\BSW\NvM\NvM.c	  1988  /* SBSW_JUSTIFICATION_BEGIN
; ..\BSW\NvM\NvM.c	  1989  
; ..\BSW\NvM\NvM.c	  1990  \ID SBSW_NvM_AccessBlockManagementArea
; ..\BSW\NvM\NvM.c	  1991   \DESCRIPTION Write access to the array storing the NvM block management information about each configured block.
; ..\BSW\NvM\NvM.c	  1992                The required array element is accessed via block Id passed to NvM - each block Id is an array index,
; ..\BSW\NvM\NvM.c	  1993                or via internal block Id 0. NvM expects the given block Id to be valid.
; ..\BSW\NvM\NvM.c	  1994   \COUNTERMEASURE \R Correctness of given parameter is checked by NvM only in case development mode is enabled.
; ..\BSW\NvM\NvM.c	  1995  
; ..\BSW\NvM\NvM.c	  1996  \ID SBSW_NvM_Access_CurrBlockInfo
; ..\BSW\NvM\NvM.c	  1997   \DESCRIPTION NvM Write access to NvM internal variable storing information about current block and job. The variable has to be
; ..\BSW\NvM\NvM.c	  1998                initialized correctly by NvM itself.
; ..\BSW\NvM\NvM.c	  1999   \COUNTERMEASURE \N The NvM itself is responsible to initialize and access its internal structures correctly. Correct usage is
; ..\BSW\NvM\NvM.c	  2000                   ensured by tests and code reviews.
; ..\BSW\NvM\NvM.c	  2001  
; ..\BSW\NvM\NvM.c	  2002  \ID SBSW_NvM_PtrAccess_PublicAPI
; ..\BSW\NvM\NvM.c	  2003   \DESCRIPTION Write access to a pointer, which is given to NvM function as parameter. NvM expects the pointer to be valid.
; ..\BSW\NvM\NvM.c	  2004   \COUNTERMEASURE \R NvM checks the given pointer not to be NULL before using it, but only in case Development Error Detection is enabled.
; ..\BSW\NvM\NvM.c	  2005  
; ..\BSW\NvM\NvM.c	  2006  \ID SBSW_NvM_FuncCall_PtrParam_CurrBlockInfo
; ..\BSW\NvM\NvM.c	  2007   \DESCRIPTION NvM passes its current job parameter to internal functions as pointer. There is no explicit check whether the current job is valid,
; ..\BSW\NvM\NvM.c	  2008                the internal function is invoked only during job processing.
; ..\BSW\NvM\NvM.c	  2009   \COUNTERMEASURE \N Actions and queries which use the internal job parameter does not check whether the parameter are valid or not. They shall
; ..\BSW\NvM\NvM.c	  2010                   only be invoked in case a valid job is currently running. Correct usage is ensured by tests and code reviews.
; ..\BSW\NvM\NvM.c	  2011  
; ..\BSW\NvM\NvM.c	  2012  \ID SBSW_NvM_FuncPtrCall_QueryAction
; ..\BSW\NvM\NvM.c	  2013   \DESCRIPTION All accesses to internal queries and actions are done via function pointer calls. There are no explicit checks whether the
; ..\BSW\NvM\NvM.c	  2014                passed function pointer is valid or not, this is ensured via correct implementation.
; ..\BSW\NvM\NvM.c	  2015   \COUNTERMEASURE \N The NvM itself is responsible to initialize and access its internal structures correctly. Correct usage is ensured by tests and code reviews.
; ..\BSW\NvM\NvM.c	  2016  
; ..\BSW\NvM\NvM.c	  2017  \ID SBSW_NvM_FuncCall_PtrParam_ParamChecker
; ..\BSW\NvM\NvM.c	  2018   \DESCRIPTION NvM uses helper functions to check pointer parameter to be valid (development error mode checks). Those functions only check the
; ..\BSW\NvM\NvM.c	  2019                given pointer to be or not to be NULL and return, they do not use the pointer. Functions expects all other parameter to be valid (checked before invoking)
; ..\BSW\NvM\NvM.c	  2020   \COUNTERMEASURE \N Functions are only used to check parameter, not to use them. Their correctness is ensured via component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2021  
; ..\BSW\NvM\NvM.c	  2022  \ID SBSW_NvM_FuncCall_PtrParam_FsmQuery
; ..\BSW\NvM\NvM.c	  2023   \DESCRIPTION Within the NvM state machine the next actions to execute are determined via queries. Invoked function gets two function pointers to queries
; ..\BSW\NvM\NvM.c	  2024                stored in an array, checks their results and return accordingly. The function expects a valid parameter to be able to call both queries.
; ..\BSW\NvM\NvM.c	  2025   \COUNTERMEASURE \N The code correctness is ensured via NvM state machine structure and is not tested explicitly. Current tests and
; ..\BSW\NvM\NvM.c	  2026                   code reviews shall confirm the structure correctness.
; ..\BSW\NvM\NvM.c	  2027  
; ..\BSW\NvM\NvM.c	  2028  \ID SBSW_NvM_FuncCall_PtrParam_FsmAction
; ..\BSW\NvM\NvM.c	  2029   \DESCRIPTION To execute actions corresponding function is invoked with an pointer parameter, pointing to an array storing both action pointers (function pointers).
; ..\BSW\NvM\NvM.c	  2030                The function expects the given pointer and included function pointers to be valid and does not check them explicitly.
; ..\BSW\NvM\NvM.c	  2031   \COUNTERMEASURE \N The code correctness is ensured via NvM state machine structure and is not tested explicitly. Current tests and
; ..\BSW\NvM\NvM.c	  2032                   state machine reviews shall confirm the structure correctness.
; ..\BSW\NvM\NvM.c	  2033  
; ..\BSW\NvM\NvM.c	  2034  \ID SBSW_NvM_FuncCall_PtrParam_QueueJob
; ..\BSW\NvM\NvM.c	  2035   \DESCRIPTION NvM uses a queue to store jobs to be processed later. The corresponding function is called from NvM's public APIs with parameter
; ..\BSW\NvM\NvM.c	  2036                passed to the public function. The queue function expects the parameter are valid - the caller has to check them, which is done
; ..\BSW\NvM\NvM.c	  2037                in development error mode.
; ..\BSW\NvM\NvM.c	  2038   \COUNTERMEASURE \R NvM checks the parameter given to a public API to be valid, in case development error mode is enabled.
; ..\BSW\NvM\NvM.c	  2039  
; ..\BSW\NvM\NvM.c	  2040  \ID SBSW_NvM_FuncCall_PtrParam_BlockMngmtArea
; ..\BSW\NvM\NvM.c	  2041   \DESCRIPTION NvM uses helper functions with pointer to according block management data as parameter. The function does not check the pointer correctness,
; ..\BSW\NvM\NvM.c	  2042                it expects the pointer is valid and uses it. NvM functions which uses the helper function are responsible for invoking with valid parameter.
; ..\BSW\NvM\NvM.c	  2043   \COUNTERMEASURE \R NvM check the parameter given to a public API to be valid, in case development error mode is enabled and invokes the helper function
; ..\BSW\NvM\NvM.c	  2044                   only with valid parameter.
; ..\BSW\NvM\NvM.c	  2045  
; ..\BSW\NvM\NvM.c	  2046  \ID SBSW_NvM_FuncCall_PtrParam_CrcAsyncJob
; ..\BSW\NvM\NvM.c	  2047   \DESCRIPTION To process queued CRC jobs with MainFunction calls NvM uses a local CRC job parameter. This parameter is passed to functions as pointer and
; ..\BSW\NvM\NvM.c	  2048                will be initialized in one and used in another functions. NvM is responsible for invoking the function in correct order.
; ..\BSW\NvM\NvM.c	  2049   \COUNTERMEASURE \N Functions do not check their parameter before using them, they expect the parameter are valid. Correct functionality shall be
; ..\BSW\NvM\NvM.c	  2050                   checked within reviews and/or component tests.
; ..\BSW\NvM\NvM.c	  2051  
; ..\BSW\NvM\NvM.c	  2052  \ID SBSW_NvM_FuncCall_PtrParam_MemIf
; ..\BSW\NvM\NvM.c	  2053   \DESCRIPTION NvM uses MemIf functions to read/ write data from/ to NV RAM. NvM is responsible to provide valid parameter as identifier or buffers.
; ..\BSW\NvM\NvM.c	  2054   \COUNTERMEASURE \T Correct NvM behavior is checked during component tests. Also code reviews shall ensure correct invoking of the MemIf module.
; ..\BSW\NvM\NvM.c	  2055  
; ..\BSW\NvM\NvM.c	  2056  \ID SBSW_NvM_AccessCrcQueue
; ..\BSW\NvM\NvM.c	  2057   \DESCRIPTION NvM uses a CRC queue to store CRC calculation jobs to be processed later. The queue is only available if SetRamBlockStatus API is enabled
; ..\BSW\NvM\NvM.c	  2058                and at least one block is configured with Calc RAM CRC. To access the queue NvM calculates element indexes.
; ..\BSW\NvM\NvM.c	  2059   \COUNTERMEASURE \T Correct NvM CRC queue behavior is checked during component tests. Code reviews shall ensure correct behavior, too.
; ..\BSW\NvM\NvM.c	  2060  
; ..\BSW\NvM\NvM.c	  2061  \ID SBSW_NvM_AccessCrcJobPtr
; ..\BSW\NvM\NvM.c	  2062   \DESCRIPTION To setup and process a CRC job NvM uses a job structure storing all required parameter. This structure is passed to different functions
; ..\BSW\NvM\NvM.c	  2063                as pointer parameter - all functions assume the pointer is valid and uses it.
; ..\BSW\NvM\NvM.c	  2064   \COUNTERMEASURE \T Correct NvM CRC job usage is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2065  
; ..\BSW\NvM\NvM.c	  2066  \ID SBSW_NvM_FuncPtrCall_CrcHandler
; ..\BSW\NvM\NvM.c	  2067   \DESCRIPTION To calculate, compare or copy CRC values NvM uses CRC helper functions - for each CRC type there are exactly 3 functions.
; ..\BSW\NvM\NvM.c	  2068                These 3 functions are stored in one CRC specific handler, which is passed to different functions as pointer. Functions which get a CRC handler
; ..\BSW\NvM\NvM.c	  2069                as pointer parameter assumes it is valid and work with it.
; ..\BSW\NvM\NvM.c	  2070   \COUNTERMEASURE \T Correct NvM CRC job usage is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2071  
; ..\BSW\NvM\NvM.c	  2072  \ID SBSW_NvM_AccessArray_BlockIdInCrc
; ..\BSW\NvM\NvM.c	  2073   \DESCRIPTION There is a special feature NvM uses to ensure the data delivered by underlying modules fits to requested NvM block - it calculate the NvM block Id
; ..\BSW\NvM\NvM.c	  2074                and current data index into the CRC. To do this the block Id and the data index are stored in an extra array and the NvM invokes the CRC module
; ..\BSW\NvM\NvM.c	  2075                with this array to calculate CRC for the data. The array is exactly 3 bytes long and specific function local.
; ..\BSW\NvM\NvM.c	  2076   \COUNTERMEASURE \T Correct buffer usage is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2077  
; ..\BSW\NvM\NvM.c	  2078  \ID SBSW_NvM_AccessPtr_CrcReassignBuffer
; ..\BSW\NvM\NvM.c	  2079   \DESCRIPTION In case the internal CRC buffer is enabled, NvM uses internal buffer to store the block CRC. During CRC job setup pointer to this buffer
; ..\BSW\NvM\NvM.c	  2080                will be stored in CRC job to be able to fill it directly.
; ..\BSW\NvM\NvM.c	  2081   \COUNTERMEASURE \T Correct buffer usage is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2082  
; ..\BSW\NvM\NvM.c	  2083  \ID SBSW_NvM_AccessJobQueue
; ..\BSW\NvM\NvM.c	  2084   \DESCRIPTION To store NvM jobs to be processed later asynchronously NvM uses a queue with configured length. The queue is an array storing all queued jobs. NvM accesses
; ..\BSW\NvM\NvM.c	  2085                the queue via calculated indexes. The index calculations has to be correct to ensure correct array accesses.
; ..\BSW\NvM\NvM.c	  2086   \COUNTERMEASURE \T Correct job queue behavior is checked during component tests and code review.
; ..\BSW\NvM\NvM.c	  2087  
; ..\BSW\NvM\NvM.c	  2088  \ID SBSW_NvM_FuncCall_PtrParam_Queue
; ..\BSW\NvM\NvM.c	  2089   \DESCRIPTION NvM job queue invokes its internal helper functions with pointer parameter. These are always valid when passing as parameter,
; ..\BSW\NvM\NvM.c	  2090                invoked functions does not check them.
; ..\BSW\NvM\NvM.c	  2091   \COUNTERMEASURE \T Correct job queue behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2092  
; ..\BSW\NvM\NvM.c	  2093  \ID SBSW_NvM_AccessPtr_QueueIndex
; ..\BSW\NvM\NvM.c	  2094   \DESCRIPTION Because the NvM job queue actually is an array NvM uses indexes to access the required queue element. Some functions
; ..\BSW\NvM\NvM.c	  2095                require pointers to those indexes as parameter - in this case the caller is responsible for providing valid pointers
; ..\BSW\NvM\NvM.c	  2096                storing valid indexes, functions does not check the given parameter.
; ..\BSW\NvM\NvM.c	  2097   \COUNTERMEASURE \T Correct job queue behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2098  
; ..\BSW\NvM\NvM.c	  2099  \ID SBSW_NvM_AccessPtr_UsedQueue
; ..\BSW\NvM\NvM.c	  2100   \DESCRIPTION In case job prioritization is enabled NvM uses two different queues: normal and high priority queue. In some situations we have to check
; ..\BSW\NvM\NvM.c	  2101                both queues - this is done via queue pointer. Pointer is initialized with one queue, then the second queue is checked, whether it shall be used
; ..\BSW\NvM\NvM.c	  2102                and the pointer will be reassigned or not. No matter how the pointer always points to a queue and can be used.
; ..\BSW\NvM\NvM.c	  2103   \COUNTERMEASURE \T Correct job queue behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2104  
; ..\BSW\NvM\NvM.c	  2105  \ID SBSW_NvM_FuncPtrCall_UserCallbacks
; ..\BSW\NvM\NvM.c	  2106   \DESCRIPTION NvM stores all user callbacks in function pointers and invokes them depending on callback type. NvM does not check whether the callback
; ..\BSW\NvM\NvM.c	  2107                functions are valid, it assumes the configuration is correct.
; ..\BSW\NvM\NvM.c	  2108   \COUNTERMEASURE \N User is responsible to provide valid functions to be called as callbacks. To avoid NULL function pointer there are checks within
; ..\BSW\NvM\NvM.c	  2109                   configuration tool. NvM does not invoke disabled callbacks (function pointers are NULL and corresponding flags are disabled)
; ..\BSW\NvM\NvM.c	  2110  
; ..\BSW\NvM\NvM.c	  2111  \ID SBSW_NvM_FuncCall_CrcModule
; ..\BSW\NvM\NvM.c	  2112   \DESCRIPTION To calculate a NvM block CRC NvM uses CRC module functions. They are always invoked with valid parameters from NvM CRC job.
; ..\BSW\NvM\NvM.c	  2113   \COUNTERMEASURE \T Correct NvM behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2114  
; ..\BSW\NvM\NvM.c	  2115  \ID SBSW_NvM_AccessArray_CrcBuffers
; ..\BSW\NvM\NvM.c	  2116   \DESCRIPTION NvM uses Crc buffers to store current Crc values to be able to compare against Crcs from NV RAM and/or to add the Crc to data.
; ..\BSW\NvM\NvM.c	  2117                Since this is NvM internal handling, NvM is responsible for correct pointer and array usage.
; ..\BSW\NvM\NvM.c	  2118   \COUNTERMEASURE \N The NvM itself is responsible to initialize and access its internal structures correctly. Correctness is ensured by
; ..\BSW\NvM\NvM.c	  2119                   component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2120  
; ..\BSW\NvM\NvM.c	  2121  \ID SBSW_NvM_AccessPtr_CrcValue
; ..\BSW\NvM\NvM.c	  2122   \DESCRIPTION NvM internal CRC job includes a buffer to store the calculated CRC in. This buffer is always valid after the job was setup successfully
; ..\BSW\NvM\NvM.c	  2123                and the calculated CRC can be store in it.
; ..\BSW\NvM\NvM.c	  2124   \COUNTERMEASURE \T Correct NvM behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2125  
; ..\BSW\NvM\NvM.c	  2126  \ID SBSW_NvM_AccessArray_InternalCopyData
; ..\BSW\NvM\NvM.c	  2127   \DESCRIPTION In some situations NvM has to copy data from one to another buffer. This is done internally using internal or job specific buffers
; ..\BSW\NvM\NvM.c	  2128                and values as buffer length. Corresponding copy function assumes all parameter are valid and uses them. The caller is responsible
; ..\BSW\NvM\NvM.c	  2129                for providing valid values.
; ..\BSW\NvM\NvM.c	  2130   \COUNTERMEASURE \T Correct NvM behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2131  
; ..\BSW\NvM\NvM.c	  2132  \ID SBSW_NvM_FuncCall_PtrParam_InternalCopyData
; ..\BSW\NvM\NvM.c	  2133   \DESCRIPTION To copy data NvM invokes the internal copy function with corresponding buffers and values. Before invoking the function it is checked whether
; ..\BSW\NvM\NvM.c	  2134                copy is possible or not. Invoked copy function does not check parameter validity.
; ..\BSW\NvM\NvM.c	  2135   \COUNTERMEASURE \T Correct NvM behavior is checked during component tests and code reviews.
; ..\BSW\NvM\NvM.c	  2136  
; ..\BSW\NvM\NvM.c	  2137  SBSW_JUSTIFICATION_END */
