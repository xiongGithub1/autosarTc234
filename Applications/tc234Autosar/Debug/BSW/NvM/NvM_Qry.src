; ..\BSW\NvM\NvM_Qry.c	   399  /*!
; ..\BSW\NvM\NvM_Qry.c	   400   * \brief Checks whether the pending background repair redundant blocks job shall be suspended (non-Destructively) or not.
; ..\BSW\NvM\NvM_Qry.c	   401   * \details Since the redundant block repairing is a background job, it can be suspended in a non-destructive way 
; ..\BSW\NvM\NvM_Qry.c	   402   *          by all possible jobs - single or multi block. This query checks whether there is a normal priority job,
; ..\BSW\NvM\NvM_Qry.c	   403   *          or multi block job (ReadAll or WriteAll). It does not care about the high priority jobs - NvM handles this itself.
; ..\BSW\NvM\NvM_Qry.c	   404   * \return FALSE 
; ..\BSW\NvM\NvM_Qry.c	   405   * \return TRUE 
; ..\BSW\NvM\NvM_Qry.c	   406   * \context TASK
; ..\BSW\NvM\NvM_Qry.c	   407   * \reentrant FALSE
; ..\BSW\NvM\NvM_Qry.c	   408   * \synchronous TRUE
; ..\BSW\NvM\NvM_Qry.c	   409   * \config Repair Redundant Blocks Api is enabled
; ..\BSW\NvM\NvM_Qry.c	   410   * \pre -
; ..\BSW\NvM\NvM_Qry.c	   411   */
; ..\BSW\NvM\NvM_Qry.c	   412  NVM_LOCAL FUNC(boolean, NVM_PRIVATE_CODE) NvM_QrySuspendRepairRedundantBlocks(void);
; ..\BSW\NvM\NvM_Qry.c	   413  
; ..\BSW\NvM\NvM_Qry.c	   414  /**********************************************************************************************************************
