; ..\BSW\Os\Os_Peripheral.c	   838          2. the size of OsCfg_PeripheralRefs is equal OS_PERIPHERALID_COUNT + 1 and
; ..\BSW\Os\Os_Peripheral.c	   839          3. each element in Os_PeripheralIdType has a value lower than OS_PERIPHERALID_COUNT.
; ..\BSW\Os\Os_Peripheral.c	   840  
; ..\BSW\Os\Os_Peripheral.c	   841  \CM CM_OS_PERIPHERALCHECK_N
; ..\BSW\Os\Os_Peripheral.c	   842        Precondition ensures that the pointer is valid. The compliance of the precondition is check during review.
; ..\BSW\Os\Os_Peripheral.c	   843  
; ..\BSW\Os\Os_Peripheral.c	   844  \CM CM_OS_PERIPHERAL_ADDRESS_S
; ..\BSW\Os\Os_Peripheral.c	   845        Verify that the complete range specified by each Os_PeripheralConfigType object in Os_Peripheral_Lcfg.c is either
; ..\BSW\Os\Os_Peripheral.c	   846        part of the writable address space or that there are no write accesses to that region via the Peripheral API.
