; ..\BSW\Os\Os_Core.c	  2638   \DESCRIPTION    Pass a reference to a variable which is passed as argument to the caller.
; ..\BSW\Os\Os_Core.c	  2639   \COUNTERMEASURE \N No measure required, as the passed pointer refers to an argument and the called function
; ..\BSW\Os\Os_Core.c	  2640                      allows that the existence of the local variable ends on return.
; ..\BSW\Os\Os_Core.c	  2641  
; ..\BSW\Os\Os_Core.c	  2642  \ID SBSW_OS_FC_POINTER2GLOBAL
; ..\BSW\Os\Os_Core.c	  2643   \DESCRIPTION    Pass a reference to a global variable.
; ..\BSW\Os\Os_Core.c	  2644   \COUNTERMEASURE \N No measure required, as the passed pointer refers to a global variable.
; ..\BSW\Os\Os_Core.c	  2645  
