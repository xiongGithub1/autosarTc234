; ..\BSW\Os\Os_Core.c	  2573  
; ..\BSW\Os\Os_Core.c	  2574  /*
; ..\BSW\Os\Os_Core.c	  2575   * Review Helper - Naming convention:
; ..\BSW\Os\Os_Core.c	  2576   * Start every justification with SWSW_OS_<Message>_<Name>.
; ..\BSW\Os\Os_Core.c	  2577   * <Message>:
; ..\BSW\Os\Os_Core.c	  2578   *  - AWA: Array write access
; ..\BSW\Os\Os_Core.c	  2579   *  - AI:  Assembler instruction
; ..\BSW\Os\Os_Core.c	  2580   *  - FC:  Function call
; ..\BSW\Os\Os_Core.c	  2581   *  - FPC: Function pointer call
; ..\BSW\Os\Os_Core.c	  2582   *  - PWA: Pointer write access
; ..\BSW\Os\Os_Core.c	  2583   *
; ..\BSW\Os\Os_Core.c	  2584   * <Name>:
; ..\BSW\Os\Os_Core.c	  2585   *  A short name which refers to the justification counter measure.
; ..\BSW\Os\Os_Core.c	  2586   */
; ..\BSW\Os\Os_Core.c	  2587  
; ..\BSW\Os\Os_Core.c	  2588  /* SBSW_JUSTIFICATION_BEGIN
; ..\BSW\Os\Os_Core.c	  2589  
; ..\BSW\Os\Os_Core.c	  2590  \ID SBSW_OS_MEMAP_UNDEF
; ..\BSW\Os\Os_Core.c	  2591   \DESCRIPTION    Undefine of memory start/end section.
; ..\BSW\Os\Os_Core.c	  2592   \COUNTERMEASURE \N No measure required. Undefine is required by AUTOSAR and has no influence on review helper results.
; ..\BSW\Os\Os_Core.c	  2593  
; ..\BSW\Os\Os_Core.c	  2594  \ID SBSW_OS_HAL_EXAMPLE
; ..\BSW\Os\Os_Core.c	  2595   \DESCRIPTION    Function call is used as an example.
; ..\BSW\Os\Os_Core.c	  2596   \COUNTERMEASURE \N No measure required, as the sample call is either replaced by the HAL implementation or justified.
; ..\BSW\Os\Os_Core.c	  2597  
; ..\BSW\Os\Os_Core.c	  2598  \ID SBSW_OS_PWA_LOCAL
; ..\BSW\Os\Os_Core.c	  2599   \DESCRIPTION    Write access to a local array.
; ..\BSW\Os\Os_Core.c	  2600   \COUNTERMEASURE \N No measure required, as the used index is static and in range.
; ..\BSW\Os\Os_Core.c	  2601  
; ..\BSW\Os\Os_Core.c	  2602  \ID SBSW_OS_FC_PRECONDITION_AND_CHECK
; ..\BSW\Os\Os_Core.c	  2603   \DESCRIPTION    The pointer passed to the called function is derived from an argument passed to the caller function.
; ..\BSW\Os\Os_Core.c	  2604                   As the caller of the caller function is enforced by preconditions to pass valid arguments only or
; ..\BSW\Os\Os_Core.c	  2605                   NULL_PTR, the pointer is correct. Preconditions are checked during code review.
; ..\BSW\Os\Os_Core.c	  2606   \COUNTERMEASURE \N [CM_OS_PRECONDITION_AND_CHECK_N]
; ..\BSW\Os\Os_Core.c	  2607  
; ..\BSW\Os\Os_Core.c	  2608  \ID SBSW_OS_PWA_PRECONDITION
; ..\BSW\Os\Os_Core.c	  2609   \DESCRIPTION    Write access to a function argument. Function design requires the caller to pass a valid pointer.
; ..\BSW\Os\Os_Core.c	  2610   \COUNTERMEASURE \N [CM_OS_PRECONDITION_N]
; ..\BSW\Os\Os_Core.c	  2611  
; ..\BSW\Os\Os_Core.c	  2612  \ID SBSW_OS_FC_PRECONDITION
; ..\BSW\Os\Os_Core.c	  2613   \DESCRIPTION    The pointer passed to the called function is derived from an argument passed to the caller function.
; ..\BSW\Os\Os_Core.c	  2614                   As the caller of the caller function is enforced by preconditions or by parameter limitations to pass
; ..\BSW\Os\Os_Core.c	  2615                   valid arguments only, the pointer is correct. Preconditions and parameter limitations are checked
; ..\BSW\Os\Os_Core.c	  2616                   during code review.
; ..\BSW\Os\Os_Core.c	  2617   \COUNTERMEASURE \N None, as the pointer validity is guaranteed.
; ..\BSW\Os\Os_Core.c	  2618  
; ..\BSW\Os\Os_Core.c	  2619  \ID SBSW_OS_PWA_RETURNEDPOINTER
; ..\BSW\Os\Os_Core.c	  2620   \DESCRIPTION    Write access to a pointer returned by a function.
; ..\BSW\Os\Os_Core.c	  2621   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW\Os\Os_Core.c	  2622  
; ..\BSW\Os\Os_Core.c	  2623  \ID SBSW_OS_FC_RETURNEDPOINTER
; ..\BSW\Os\Os_Core.c	  2624   \DESCRIPTION    The passed pointer is derived from a function, which guarantees that the pointer is valid.
; ..\BSW\Os\Os_Core.c	  2625   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW\Os\Os_Core.c	  2626  
; ..\BSW\Os\Os_Core.c	  2627  \ID SBSW_OS_FC_RETURNEDPOINTERWITHCHECK
; ..\BSW\Os\Os_Core.c	  2628   \DESCRIPTION    The passed pointer is derived from a function, which guarantees that the pointer is valid or a
; ..\BSW\Os\Os_Core.c	  2629                   NULL_PTR.
; ..\BSW\Os\Os_Core.c	  2630   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW\Os\Os_Core.c	  2631  
; ..\BSW\Os\Os_Core.c	  2632  \ID SBSW_OS_FC_POINTER2LOCAL
; ..\BSW\Os\Os_Core.c	  2633   \DESCRIPTION    Pass a reference to a local variable.
; ..\BSW\Os\Os_Core.c	  2634   \COUNTERMEASURE \N No measure required, as the passed pointer refers to a local variable and the called function
; ..\BSW\Os\Os_Core.c	  2635                      allows that the existence of the local variable ends on return.
; ..\BSW\Os\Os_Core.c	  2636  
