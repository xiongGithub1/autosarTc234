; ..\BSW\Os\Os_AccessCheck.c	   108  /*! \brief        Returns the access right of a thread for the given memory region.
; ..\BSW\Os\Os_AccessCheck.c	   109   *  \details      --no details--
; ..\BSW\Os\Os_AccessCheck.c	   110   *
; ..\BSW\Os\Os_AccessCheck.c	   111   *  \note         Limitation: The region to be checked has to be part of a configured region. If the region to be
; ..\BSW\Os\Os_AccessCheck.c	   112   *                            checked is completely covered by two or more regions, the result will be no access.
; ..\BSW\Os\Os_AccessCheck.c	   113   *
; ..\BSW\Os\Os_AccessCheck.c	   114   *  \param[in]    AccessRights        The access rights of the object to be checked. Parameter must not be NULL.
