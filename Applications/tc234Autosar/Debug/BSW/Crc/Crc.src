; ..\BSW\Crc\Crc.c	    14   *         \file  Crc.c
; ..\BSW\Crc\Crc.c	    15   *        \brief  Cyclic redundancy check header file
; ..\BSW\Crc\Crc.c	    16   *
; ..\BSW\Crc\Crc.c	    17   *      \details  Crc module is used to calculate cyclic codes, which encode messages by adding a fixed-length check
; ..\BSW\Crc\Crc.c	    18   *                value, for the purpose of error detection. Data blocks get a short CRC value attached, which is
; ..\BSW\Crc\Crc.c	    19   *                based on the remainder of a polynomial division of their contents. Upon retrieval of block data,
; ..\BSW\Crc\Crc.c	    20   *                the calculation is repeated and the calculated value is compared to the attached CRC value in order
; ..\BSW\Crc\Crc.c	    21   *                to ensure data integrity.
; ..\BSW\Crc\Crc.c	    22   *
; ..\BSW\Crc\Crc.c	    23   *********************************************************************************************************************/
