; ..\BSW\CanTp\CanTp.c	  6143                                 - CANTP_SINGLE_RX_BUFFER_OPTIMIZED = STD_OFF
; ..\BSW\CanTp\CanTp.c	  6144                                 - MSR_PDUR_API_AR_VERSION is undefined
; ..\BSW\CanTp\CanTp.c	  6145                                 - CANTP_TX_QUEUE_SIZE = 4 (The generated files shall not redefine the value defined in CanTp_Types.h)
; ..\BSW\CanTp\CanTp.c	  6146                                 - CANTP_PDUR_API_AR_VERSION = 0x412
; ..\BSW\CanTp\CanTp.c	  6147                                 - CANTP_TX_FC_FROM_ISR is undefined
; ..\BSW\CanTp\CanTp.c	  6148                                 - CANTP_RX_GET_BUFFER_FROM_ISR is undefined
; ..\BSW\CanTp\CanTp.c	  6149                                 - CANTP_TX_GET_BUFFER_FROM_ISR is undefined
; ..\BSW\CanTp\CanTp.c	  6150                                 - CANTP_IGNORE_FC_WITH_RES_STMIN is undefined
; ..\BSW\CanTp\CanTp.c	  6151                                 - CANTP_IGNORE_CF_WITH_WRONG_SN is undefined
; ..\BSW\CanTp\CanTp.c	  6152                                 - CANTP_IGNORE_FC_OVFL_INVALID_FS is undefined
