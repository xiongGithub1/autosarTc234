; ..\BSW\CanTp\CanTp.c	  6122                                    a value < CanTp_Cfg_GetNumTxConfPdus.
; ..\BSW\CanTp\CanTp.c	  6123  
; ..\BSW\CanTp\CanTp.c	  6124  \CM CM_CANTP_TXCFG_TXCONFPDUIDS   The macro CanTp_TxCfg_GetTxConfPduId must always return a value < CanTp_Cfg_GetNumTxConfPdus.
; ..\BSW\CanTp\CanTp.c	  6125  
