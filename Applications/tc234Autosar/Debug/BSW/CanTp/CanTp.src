; ..\BSW\CanTp\CanTp.c	  6119                                    For all Extended or Mixed11 Addressing Tx N-SDUs, (CanTp_TxCfg_GetMaxPayload + 2) must be less or equal CANTP_MAX_FRAME_LENGTH
; ..\BSW\CanTp\CanTp.c	  6120  
