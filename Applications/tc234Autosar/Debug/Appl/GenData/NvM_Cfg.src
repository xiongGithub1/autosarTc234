; ..\Appl\GenData\NvM_Cfg.c	   535  /* Permanent RAM and ROM block length checks - compile time (only available for blocks with enabled length check */
; ..\Appl\GenData\NvM_Cfg.c	   536  
; ..\Appl\GenData\NvM_Cfg.c	   537  /* How does it work:
; ..\Appl\GenData\NvM_Cfg.c	   538   * data length = sizeof(ramBlock - CrcLength 
; ..\Appl\GenData\NvM_Cfg.c	   539   *     - CRC internal buffer enabled: CRC length == 0, RAM blocks store only data, CRC is handles internally
; ..\Appl\GenData\NvM_Cfg.c	   540   *     - CRC internal buffer disabled: CRC length is the number of CRC bytes, for blocks without CRC the length == 0
; ..\Appl\GenData\NvM_Cfg.c	   541   *     - for ROM blocks the CRC does not matter
; ..\Appl\GenData\NvM_Cfg.c	   542   * Data length has to be > or < or == to configured NvM block length, depending on configuration (see above). 
; ..\Appl\GenData\NvM_Cfg.c	   543   * In case the lengths do not match a bitfield with length -1 will be created and shall cause a compiler error.
; ..\Appl\GenData\NvM_Cfg.c	   544   * The compiler error shall mark the line with invalid bitfield (bitfield length == -1) - the line includes all required information:
; ..\Appl\GenData\NvM_Cfg.c	   545   *     - Block_ + NvM block name
; ..\Appl\GenData\NvM_Cfg.c	   546   *     - length error description
; ..\Appl\GenData\NvM_Cfg.c	   547   *     - RAM block name, CRC length and configured NvM block length
; ..\Appl\GenData\NvM_Cfg.c	   548   */
; ..\Appl\GenData\NvM_Cfg.c	   549  
; ..\Appl\GenData\NvM_Cfg.c	   550  typedef unsigned int NvM_LengthCheck;
; ..\Appl\GenData\NvM_Cfg.c	   551   
; ..\Appl\GenData\NvM_Cfg.c	   552  /* Block Length Check and Automatic Block Length enabled: error if sizeof RAM block is greater than the configured block length */
; ..\Appl\GenData\NvM_Cfg.c	   553  /* PRQA S 3453 1 */ /* MD_MSR_19.7 */
; ..\Appl\GenData\NvM_Cfg.c	   554  #define SizeOfRamBlockGreaterThanConfiguredLength(ramBlock, crcLength, blockLength) (((sizeof(ramBlock) - (crcLength)) > (blockLength)) ? -1 : 1)
; ..\Appl\GenData\NvM_Cfg.c	   555  /* Block Length Check and Strict Length Check enabled: error if the sizeof RAM block does not match the configured block length */
; ..\Appl\GenData\NvM_Cfg.c	   556  /* PRQA S 3453 1 */ /* MD_MSR_19.7 */
; ..\Appl\GenData\NvM_Cfg.c	   557  #define SizeOfRamBlockDoesNotMatchConfiguredLength(ramBlock, crcLength, blockLength) (((sizeof(ramBlock) - (crcLength)) != (blockLength)) ? -1 : 1)
; ..\Appl\GenData\NvM_Cfg.c	   558  /* Block Length Check enabled and Strict Length Check disabled: error if the sizeof RAM block is less than the configured block length */
; ..\Appl\GenData\NvM_Cfg.c	   559  /* PRQA S 3453 1 */ /* MD_MSR_19.7 */
; ..\Appl\GenData\NvM_Cfg.c	   560  #define SizeOfRamBlockLessThanConfiguredLength(ramBlock, crcLength, blockLength) (((sizeof(ramBlock) - (crcLength)) < (blockLength)) ? -1 : 1)
; ..\Appl\GenData\NvM_Cfg.c	   561  
; ..\Appl\GenData\NvM_Cfg.c	   562  /* RAM block length checks */
; ..\Appl\GenData\NvM_Cfg.c	   563  
; ..\Appl\GenData\NvM_Cfg.c	   564  
