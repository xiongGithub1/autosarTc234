; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    48  
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    49  /*Notes on Requirements:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    50  PWM040: General Limitation: All Channels should have same frequency
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    51          to be observed by the user.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    52  */
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    53  /*
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    54  Configuration:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    55  PWM Channel Configuration:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    56  Elements / Attributes
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    57  1. Notification function pointer (if required)
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    58  2. Shift Value, only for PWM_FIXED_PERIOD_SHIFTED Class
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    59     Input a value between 0 and 0x8000.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    60  3. Default Duty Cycle ( duty cycle value between
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    61     0 and 0x8000)
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    62  4. Pwm_Period:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    63     Enter in ticks
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    64     PWM070: All time units should be in ticks.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    65  5. Pwm_ConfigChannel:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    66     Go in the following parameter order
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    67     a) Reference to Channel Number, for a Shifted, Center Aligned and
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    68     Zero Shifted channel, a reference must be given. For a variable
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    69     and Fixed Period channel class, reference should not be given.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    70     Reference should be given in the form of channel number index.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    71     b) Channel Class
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    72        Possible Options: PWM_FIXED_PERIOD, PWM_FIXED_PERIOD_SHIFTED,
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    73        PWM_FIXED_PERIOD_CENTER_ALIGNED, PWM_VARIABLE_PERIOD
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    74     c) Channel Idle State:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    75        Possible Options: PWM_LOW, PWM_HIGH
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    76        Output line goes into Idle state either after Pwm_SetOutputtoIdle
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    77        or Pwm_DeInit.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    78     d) Channel Polarity:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    79        Possible Options: PWM_LOW, PWM_HIGH
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    80        Initial Polarity state of the channel.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    81     e) Assigned HW Resource:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    82        TOM/ATOM Channel Number.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    83  6. PwmSafetySignalType to indicate Chanel is ASIL or QM
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    84     Needed only when safety is enabled
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    85  7. PwmSafetyChannelIndex to store the channel index of
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    86     ASIL or QM signal.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    87   */
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    88  
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    89  /*******************************************************************************
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    90  **                      Private Function Declarations                         **
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    91  *******************************************************************************/
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    92  /*
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    93  Function Like Macro:Pwm_lConfigChannel
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    94  Macro that packs the PWM Channel Information.
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    95  Input Parameters:
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    96  ShiftReset: Shifted channel is reset by itself or by other channel
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    97  ShiftedSpl: Special handling of shifted channel is enabled or not
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    98  IsReferenceChannel:Is the channel reference to other channel or not
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	    99  ReferenceChannel : Reference Channel
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   100  ChannelClass : Channel Class
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   101  ChannelCoherency : Channel Coherency
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   102  IdleState : Idle State
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   103  Polarity : Channel Polarity
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   104  AssignedHwUnit : Hardware Unit Used
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   105  */ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   106  /*IFX_MISRA_RULE_19_07_STATUS=Function like macro is uded to reduce the 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   107    memory usage*/
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   108  #define Pwm_lConfigChannel(ShiftReset,                   \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   109                             ShiftedSpl,                   \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   110                             IsReferenceChannel,           \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   111                             ReferenceChannel,             \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   112                             ChannelClass,                 \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   113                             ChannelCoherency,             \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   114                             IdleState,                    \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   115                             Polarity,                     \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   116                             AssignedHwUnit)               \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   117                ((uint32)( ((uint32)(ShiftReset) << 22UL)         |   \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   118                           ((uint32)(ShiftedSpl) << 21UL)         |   \ 
; ..\Appl\GenData\src\Pwm_17_Gtm_PBCfg.c	   119                           ((uint32)(IsReferenceChannel) << 20UL) |   \ 
